<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetPreviewWeeklyDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">bottom|center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetPreviewWeeklyBarEmpty">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/widget_preview_bar_empty</item>
    </style>

    <style name="WidgetPreviewWeeklyBarEmptyDark">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/widget_preview_bar_empty_dark</item>
    </style>

    <style name="WidgetPreviewWeeklyLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:textColor">#6B6B68</item>
        <item name="android:textSize">9sp</item>
    </style>
</resources>
